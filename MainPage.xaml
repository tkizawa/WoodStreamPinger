<Page
    x:Class="WoodStreamPinger.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WoodStreamPinger.Models"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <!-- 0: ヘッダー & ツールバー -->
            <RowDefinition Height="Auto" />
            <!-- 1: パラメータ設定 (Expander) -->
            <RowDefinition Height="Auto" />
            <!-- 2: メイン一覧 (テーブル) -->
            <RowDefinition Height="*" />
            <!-- 3: 下部サマリーステータスバー -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 0: ヘッダー & コマンドバー ==================== -->
        <Border Grid.Row="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- アプリタイトル & バージョン -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10" Margin="0,0,12,0">
                    <FontIcon Glyph="&#xE774;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.Loc.GetString('App_Title'), Mode=OneWay}"
                                       FontSize="18" FontWeight="SemiBold" />
                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.Loc.GetString('App_Version'), Mode=OneWay}"
                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.Loc.GetString('App_Subtitle'), Mode=OneWay}"
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- メイン操作ボタン群 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- 全開始 -->
                    <Button Command="{x:Bind ViewModel.StartAllCommand}"
                            Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock Text="{x:Bind ViewModel.Loc.GetString('Toolbar_StartAll'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <!-- 全停止 -->
                    <Button Command="{x:Bind ViewModel.StopAllCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE71A;" FontSize="14" />
                            <TextBlock Text="{x:Bind ViewModel.Loc.GetString('Toolbar_StopAll'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <!-- 統計リセット -->
                    <Button Command="{x:Bind ViewModel.ResetStatsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE777;" FontSize="14" />
                            <TextBlock Text="{x:Bind ViewModel.Loc.GetString('Toolbar_ResetStats'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <!-- ホスト追加 -->
                    <Button Click="OnAddHostClicked">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="{x:Bind ViewModel.Loc.GetString('Toolbar_AddHost'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 右側: テーマ & 言語切り替え -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- テーマ切り替え -->
                    <ComboBox x:Name="ThemeComboBox"
                              SelectionChanged="OnThemeSelectionChanged"
                              MinWidth="120" VerticalAlignment="Center">
                        <ComboBoxItem Content="{x:Bind ViewModel.Loc.GetString('Settings_Theme_System'), Mode=OneWay}" Tag="System" />
                        <ComboBoxItem Content="{x:Bind ViewModel.Loc.GetString('Settings_Theme_Light'), Mode=OneWay}" Tag="Light" />
                        <ComboBoxItem Content="{x:Bind ViewModel.Loc.GetString('Settings_Theme_Dark'), Mode=OneWay}" Tag="Dark" />
                    </ComboBox>

                    <!-- 言語切り替え -->
                    <ComboBox x:Name="LanguageComboBox"
                              SelectionChanged="OnLanguageSelectionChanged"
                              MinWidth="110" VerticalAlignment="Center">
                        <ComboBoxItem Content="{x:Bind ViewModel.Loc.GetString('Settings_Language_Auto'), Mode=OneWay}" Tag="Auto" />
                        <ComboBoxItem Content="{x:Bind ViewModel.Loc.GetString('Settings_Language_Ja'), Mode=OneWay}" Tag="ja-JP" />
                        <ComboBoxItem Content="{x:Bind ViewModel.Loc.GetString('Settings_Language_En'), Mode=OneWay}" Tag="en-US" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 1: パラメータ設定 (Expander) ==================== -->
        <Expander Grid.Row="1"
                  Header="{x:Bind ViewModel.Loc.GetString('Param_Title'), Mode=OneWay}"
                  HorizontalAlignment="Stretch"
                  Margin="16,8,16,4">
            <Grid Padding="12" ColumnSpacing="20" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- タイムアウト (ms) -->
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.Loc.GetString('Param_Timeout'), Mode=OneWay}" FontSize="12" />
                    <NumberBox Value="{x:Bind ViewModel.TimeoutMs, Mode=TwoWay}"
                               SmallChange="100" LargeChange="500" Minimum="100" Maximum="60000" SpinButtonPlacementMode="Inline" />
                </StackPanel>

                <!-- 送信間隔 (ms) -->
                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.Loc.GetString('Param_Interval'), Mode=OneWay}" FontSize="12" />
                    <NumberBox Value="{x:Bind ViewModel.IntervalMs, Mode=TwoWay}"
                               SmallChange="100" LargeChange="1000" Minimum="50" Maximum="60000" SpinButtonPlacementMode="Inline" />
                </StackPanel>

                <!-- バッファサイズ (Bytes) -->
                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.Loc.GetString('Param_BufferSize'), Mode=OneWay}" FontSize="12" />
                    <NumberBox Value="{x:Bind ViewModel.BufferSize, Mode=TwoWay}"
                               SmallChange="16" LargeChange="64" Minimum="1" Maximum="65500" SpinButtonPlacementMode="Inline" />
                </StackPanel>

                <!-- TTL -->
                <StackPanel Grid.Row="0" Grid.Column="3" Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.Loc.GetString('Param_Ttl'), Mode=OneWay}" FontSize="12" />
                    <NumberBox Value="{x:Bind ViewModel.Ttl, Mode=TwoWay}"
                               SmallChange="1" LargeChange="16" Minimum="1" Maximum="255" SpinButtonPlacementMode="Inline" />
                </StackPanel>

                <!-- フラグメント禁止 -->
                <CheckBox Grid.Row="1" Grid.Column="0"
                          IsChecked="{x:Bind ViewModel.Parameters.DontFragment, Mode=TwoWay}"
                          Content="{x:Bind ViewModel.Loc.GetString('Param_DontFragment'), Mode=OneWay}"
                          VerticalAlignment="Center" />

                <!-- 試行回数 (0 = 継続ループ) -->
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.Loc.GetString('Param_Count'), Mode=OneWay}" FontSize="12" />
                    <NumberBox Value="{x:Bind ViewModel.Count, Mode=TwoWay}"
                               SmallChange="1" LargeChange="5" Minimum="0" Maximum="100000"
                               PlaceholderText="0 = 継続ループ" SpinButtonPlacementMode="Inline" />
                </StackPanel>
            </Grid>
        </Expander>

        <!-- ==================== 2: メイン一覧 (テーブル) ==================== -->
        <Border Grid.Row="2" Margin="16,4,16,8"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- テーブルヘッダー -->
                    <RowDefinition Height="Auto" />
                    <!-- テーブルアイテム行 -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- テーブル見出し (Header) -->
                <Border Grid.Row="0"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,8"
                        CornerRadius="8,8,0,0">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*" /> <!-- ホスト名 -->
                            <ColumnDefinition Width="1.5*" /> <!-- 解決済みIP -->
                            <ColumnDefinition Width="1.4*" /> <!-- ステータス -->
                            <ColumnDefinition Width="1.1*" /> <!-- 最新RTT -->
                            <ColumnDefinition Width="1.1*" /> <!-- 送信 -->
                            <ColumnDefinition Width="1.1*" /> <!-- 受信 -->
                            <ColumnDefinition Width="1.3*" /> <!-- 損失(率) -->
                            <ColumnDefinition Width="1.0*" /> <!-- 最小RTT -->
                            <ColumnDefinition Width="1.0*" /> <!-- 最大RTT -->
                            <ColumnDefinition Width="1.1*" /> <!-- 平均RTT -->
                            <ColumnDefinition Width="140" />  <!-- 操作 -->
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.Loc.GetString('Grid_Host'), Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Loc.GetString('Grid_ResolvedIp'), Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Loc.GetString('Grid_Status'), Mode=OneWay}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.Loc.GetString('Grid_LastRtt'), Mode=OneWay}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="{x:Bind ViewModel.Loc.GetString('Grid_Sent'), Mode=OneWay}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="{x:Bind ViewModel.Loc.GetString('Grid_Received'), Mode=OneWay}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="6" Text="{x:Bind ViewModel.Loc.GetString('Grid_LossRate'), Mode=OneWay}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="7" Text="{x:Bind ViewModel.Loc.GetString('Grid_MinRtt'), Mode=OneWay}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="8" Text="{x:Bind ViewModel.Loc.GetString('Grid_MaxRtt'), Mode=OneWay}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="9" Text="{x:Bind ViewModel.Loc.GetString('Grid_AvgRtt'), Mode=OneWay}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="10" Text="{x:Bind ViewModel.Loc.GetString('Grid_Actions'), Mode=OneWay}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- ホスト一覧 (ListView) -->
                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Targets, Mode=OneWay}"
                          SelectionMode="Single"
                          SelectedItem="{x:Bind ViewModel.SelectedTarget, Mode=TwoWay}"
                          Padding="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="16,6" />
                            <Setter Property="MinHeight" Value="44" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:HostPingTarget">
                            <Grid ColumnSpacing="8" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*" /> <!-- ホスト名 -->
                                    <ColumnDefinition Width="1.5*" /> <!-- 解決済みIP -->
                                    <ColumnDefinition Width="1.4*" /> <!-- ステータス -->
                                    <ColumnDefinition Width="1.1*" /> <!-- 最新RTT -->
                                    <ColumnDefinition Width="1.1*" /> <!-- 送信 -->
                                    <ColumnDefinition Width="1.1*" /> <!-- 受信 -->
                                    <ColumnDefinition Width="1.3*" /> <!-- 損失(率) -->
                                    <ColumnDefinition Width="1.0*" /> <!-- 最小RTT -->
                                    <ColumnDefinition Width="1.0*" /> <!-- 最大RTT -->
                                    <ColumnDefinition Width="1.1*" /> <!-- 平均RTT -->
                                    <ColumnDefinition Width="140" />  <!-- 操作 -->
                                </Grid.ColumnDefinitions>

                                <!-- ホスト名 -->
                                <TextBlock Grid.Column="0" Text="{x:Bind Host, Mode=OneWay}"
                                           FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                <!-- 解決済みIP -->
                                <TextBlock Grid.Column="1" Text="{x:Bind ResolvedIp, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                <!-- ステータスバッジ -->
                                <Border Grid.Column="2"
                                        Background="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusToBrushConverter}}"
                                        CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                               FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                </Border>

                                <!-- 最新RTT -->
                                <TextBlock Grid.Column="3"
                                           Text="{x:Bind LastRttDisplay, Mode=OneWay}"
                                           Foreground="{x:Bind LastRttMs, Mode=OneWay, Converter={StaticResource RttToBrushConverter}}"
                                           FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                <!-- 送信数 -->
                                <TextBlock Grid.Column="4" Text="{x:Bind SentCount, Mode=OneWay}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />

                                <!-- 受信数 -->
                                <TextBlock Grid.Column="5" Text="{x:Bind ReceivedCount, Mode=OneWay}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />

                                <!-- 損失数 (損失率%) -->
                                <TextBlock Grid.Column="6"
                                           Text="{x:Bind LossDisplay, Mode=OneWay}"
                                           Foreground="{x:Bind LossRate, Mode=OneWay, Converter={StaticResource LossRateToBrushConverter}}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />

                                <!-- 最小RTT -->
                                <TextBlock Grid.Column="7" Text="{x:Bind MinRttDisplay, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />

                                <!-- 最大RTT -->
                                <TextBlock Grid.Column="8" Text="{x:Bind MaxRttDisplay, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />

                                <!-- 平均RTT -->
                                <TextBlock Grid.Column="9" Text="{x:Bind AvgRttDisplay, Mode=OneWay}"
                                           FontWeight="Medium"
                                           Foreground="{x:Bind AvgRttMs, Mode=OneWay, Converter={StaticResource RttToBrushConverter}}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />

                                <!-- アクションボタン群 -->
                                <StackPanel Grid.Column="10" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- 個別開始 -->
                                    <Button Click="OnStartItemClicked"
                                            Tag="{x:Bind}"
                                            Padding="6,4" ToolTipService.ToolTip="Start">
                                        <FontIcon Glyph="&#xE768;" FontSize="11" />
                                    </Button>

                                    <!-- 個別停止 -->
                                    <Button Click="OnStopItemClicked"
                                            Tag="{x:Bind}"
                                            Padding="6,4" ToolTipService.ToolTip="Stop">
                                        <FontIcon Glyph="&#xE71A;" FontSize="11" />
                                    </Button>

                                    <!-- 個別削除 -->
                                    <Button Click="OnRemoveItemClicked"
                                            Tag="{x:Bind}"
                                            Padding="6,4" ToolTipService.ToolTip="Remove">
                                        <FontIcon Glyph="&#xE74D;" FontSize="11" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- ==================== 3: 下部サマリーステータスバー ==================== -->
        <Border Grid.Row="3"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左側: サマリー統計情報 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <!-- 登録ホスト数 -->
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.Loc.GetString('Status_TotalHosts'), Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.TotalHostsCount, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>

                    <!-- 実行中 -->
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.Loc.GetString('Status_ActiveHosts'), Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.ActiveHostsCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="12" />
                    </StackPanel>

                    <!-- 総送信数 -->
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.Loc.GetString('Status_TotalSent'), Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.TotalSent, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>

                    <!-- 総受信数 -->
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.Loc.GetString('Status_TotalReceived'), Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.TotalReceived, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>

                    <!-- 総損失数 -->
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.Loc.GetString('Status_TotalLost'), Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.TotalLost, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>

                    <!-- 総合損失率 -->
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.Loc.GetString('Status_OverallLossRate'), Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.OverallLossRateDisplay, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>

                    <!-- 全体平均RTT -->
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.Loc.GetString('Status_OverallAvgRtt'), Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.OverallAvgRttDisplay, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <!-- 右側: クリアボタン -->
                <Button Grid.Column="1" Command="{x:Bind ViewModel.ClearAllTargetsCommand}"
                        Padding="8,4" Background="Transparent" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Clear All" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
