<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WoodStreamPinger.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WoodStreamPinger"
    xmlns:converters="using:WoodStreamPinger.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- コンバーター定義 -->
            <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
            <converters:RttToBrushConverter x:Key="RttToBrushConverter" />
            <converters:LossRateToBrushConverter x:Key="LossRateToBrushConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
